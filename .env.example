# ─────────────────────────────────────────────
# GYDS RPC Node — Environment Configuration
# Copy to .env and fill in your values
# ─────────────────────────────────────────────

# Chain
GYDS_CHAIN_ID=13370
GYDS_NODE_MODE=full

# Networking
GYDS_RPC_PORT=8545
GYDS_RPC_HOST=0.0.0.0
GYDS_P2P_PORT=30305
GYDS_WS_PORT=8546

# Domain for Nginx reverse proxy + SSL
GYDS_DOMAIN=rpc.example.com

# Storage
GYDS_DATA_DIR=/app/data

# Bootstrap peers
# GYDS_BOOTSTRAP_NODES=tcp://node1.gydschain.io:30303

# Logging (trace|debug|info|warn|error)
GYDS_LOG_LEVEL=info
